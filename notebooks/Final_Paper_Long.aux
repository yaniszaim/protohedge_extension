\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Empirical CVaR$_{5\%}$ by ticker and model for European short-call hedging. Less negative CVaR$_{5\%}$ values indicate smaller average losses in the worst five percent of held-out episodes. A ProtoHedge frontier provides the strongest CVaR$_{5\%}$ result for every ticker.}}{9}{figure.caption.32}\protected@file@percent }
\newlabel{fig:european-cvar-heatmap}{{2}{9}{Empirical CVaR$_{5\%}$ by ticker and model for European short-call hedging. Less negative CVaR$_{5\%}$ values indicate smaller average losses in the worst five percent of held-out episodes. A ProtoHedge frontier provides the strongest CVaR$_{5\%}$ result for every ticker}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cumulative position-bound occupancy by ticker and model. Each cell is the fraction of held-out decision times at which the cumulative hedge is at a hard position limit. Lower values are more economically credible. The comparison among learned policies shows that ProtoHedge often reduces reliance on the hard bounds relative to vanilla Deep Hedging.}}{9}{figure.caption.33}\protected@file@percent }
\newlabel{fig:european-bound-heatmap}{{3}{9}{Cumulative position-bound occupancy by ticker and model. Each cell is the fraction of held-out decision times at which the cumulative hedge is at a hard position limit. Lower values are more economically credible. The comparison among learned policies shows that ProtoHedge often reduces reliance on the hard bounds relative to vanilla Deep Hedging}{figure.caption.33}{}}
