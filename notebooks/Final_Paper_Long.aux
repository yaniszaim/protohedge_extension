\newlabel{tab:european-ticker-comparison}{{2}{8}{Ticker-level European-option comparison with vanilla Deep Hedging. Higher mean gains and CVaR$_{5\%}$ are better, while lower bound occupancy is better. The two ProtoHedge columns use the screened mean and tail frontiers, respectively}{table.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Mean gains by ticker and model for European short-call hedging. Each row is a ticker and each cell is the mean held-out gain averaged over seeds. Comparisons should be made horizontally within a ticker: higher, or less negative, values are better.}}{8}{figure.caption.31}\protected@file@percent }
\newlabel{fig:european-mean-heatmap}{{1}{8}{Mean gains by ticker and model for European short-call hedging. Each row is a ticker and each cell is the mean held-out gain averaged over seeds. Comparisons should be made horizontally within a ticker: higher, or less negative, values are better}{figure.caption.31}{}}
