\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Average European-option results across the ten-ticker panel. Higher mean gains and higher CVaR$_{5\%}$ values are better; lower bound occupancy is better. Shortfall probability is reported as a secondary distributional diagnostic and should be interpreted jointly with the mean and tail-loss measures.}}{7}{table.caption.29}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:european-panel-average}{{1}{7}{Average European-option results across the ten-ticker panel. Higher mean gains and higher CVaR$_{5\%}$ values are better; lower bound occupancy is better. Shortfall probability is reported as a secondary distributional diagnostic and should be interpreted jointly with the mean and tail-loss measures}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ticker-level European-option comparison with vanilla Deep Hedging. Higher mean gains and CVaR$_{5\%}$ are better, while lower bound occupancy is better. The two ProtoHedge columns use the screened mean and tail frontiers, respectively.}}{7}{table.caption.30}\protected@file@percent }
\newlabel{tab:european-ticker-comparison}{{2}{7}{Ticker-level European-option comparison with vanilla Deep Hedging. Higher mean gains and CVaR$_{5\%}$ are better, while lower bound occupancy is better. The two ProtoHedge columns use the screened mean and tail frontiers, respectively}{table.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Mean gains by ticker and model for European short-call hedging. Each row is a ticker and each cell is the mean held-out gain averaged over seeds. Comparisons should be made horizontally within a ticker: higher, or less negative, values are better.}}{7}{figure.caption.31}\protected@file@percent }
\newlabel{fig:european-mean-heatmap}{{1}{7}{Mean gains by ticker and model for European short-call hedging. Each row is a ticker and each cell is the mean held-out gain averaged over seeds. Comparisons should be made horizontally within a ticker: higher, or less negative, values are better}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Empirical CVaR$_{5\%}$ by ticker and model for European short-call hedging. Less negative CVaR$_{5\%}$ values indicate smaller average losses in the worst five percent of held-out episodes. A ProtoHedge frontier provides the strongest CVaR$_{5\%}$ result for every ticker.}}{8}{figure.caption.32}\protected@file@percent }
\newlabel{fig:european-cvar-heatmap}{{2}{8}{Empirical CVaR$_{5\%}$ by ticker and model for European short-call hedging. Less negative CVaR$_{5\%}$ values indicate smaller average losses in the worst five percent of held-out episodes. A ProtoHedge frontier provides the strongest CVaR$_{5\%}$ result for every ticker}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cumulative position-bound occupancy by ticker and model. Each cell is the fraction of held-out decision times at which the cumulative hedge is at a hard position limit. Lower values are more economically credible. The comparison among learned policies shows that ProtoHedge often reduces reliance on the hard bounds relative to vanilla Deep Hedging.}}{8}{figure.caption.33}\protected@file@percent }
\newlabel{fig:european-bound-heatmap}{{3}{8}{Cumulative position-bound occupancy by ticker and model. Each cell is the fraction of held-out decision times at which the cumulative hedge is at a hard position limit. Lower values are more economically credible. The comparison among learned policies shows that ProtoHedge often reduces reliance on the hard bounds relative to vanilla Deep Hedging}{figure.caption.33}{}}
